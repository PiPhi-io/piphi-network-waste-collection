{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-waste-collection",
  "name": "Waste collection",
  "version": "0.1.0",
  "description": "Track the next manually configured household waste or recycling collection.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "cloud-polling-api",
    "domain": "cloud-api",
    "preset_summary": "Cloud API starter with vendor endpoint and token-oriented configuration."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "docker.io/piphinetwork/piphi-network-waste-collection:0.1.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "docker.io/piphinetwork/piphi-network-waste-collection:0.1.0",
        "ports": [
          {
            "container": 4205,
            "host": 4205
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "alias",
      "next_collection_date",
      "collection_type",
      "schedule_timezone"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "collection_type"
    ]
  },
  "identity": {
    "fields": [
      "collection_type"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "next_collection_date": {"kind": "sensor", "value_kind": "text"},
    "next_collection_type": {"kind": "sensor", "value_kind": "text"},
    "days_until_collection": {"kind": "sensor", "value_kind": "numeric", "unit": "days"},
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "demo-device",
      "name": "Demo Device",
      "device_id": "demo-device",
      "entity_type": "sensor",
      "capabilities": [
        "connected",
        "next_collection_date",
        "next_collection_type",
        "days_until_collection",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {"registry_id": "io.piphi.waste-next-collection", "version_range": ">=0.1,<1", "auto_install": true}
    ]
  },
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Waste collection",
    "summary": "Track the next manually configured household waste or recycling collection.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-waste-collection/issues",
      "security_contact": "support@piphi.io"
    },
    "access_declared": true,
    "access": [],
    "compatibility": [
      {
        "brand": "PiPhi",
        "model": "User-maintained collection date"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-waste-collection",
    "support_url": "https://github.com/PiPhi-io/piphi-network-waste-collection/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-waste-collection/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "waste collection schedule"
    ],
    "protocols": [
      "manual date configuration"
    ],
    "discovery_methods": [
      "manual configuration"
    ],
    "connectivity": "local",
    "offline_support": "full",
    "privacy_url": "https://github.com/PiPhi-io/piphi-network-waste-collection/blob/main/docs/privacy.md"
  }
}
